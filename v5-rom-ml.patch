+++ b/retina/conformal.py
@@ -0,0 +1,70 @@
+"""Class-conditional (Mondrian) split conformal prediction.
+
+Turns any probabilistic classifier into one that outputs a *set* of labels with a coverage
+guarantee. For a new scan with true label y and a user-chosen error level alpha:
+
+    P( y ∈ C(x) | y = k ) >= 1 - alpha        for every class k
+
+provided calibration and test scans are exchangeable (drawn the same way, same scanner).
+This is the honest replacement for "100% triage guaranteed": the guarantee is stated, finite-sample,
+distribution-free, and it holds per class (so it bounds the miss rate for diseased eyes).
+
+Recipe (Vovk et al. 2005; Angelopoulos & Bates 2021):
+    1. split the training patients into proper-train and calibration
+    2. fit the model on proper-train
+    3. nonconformity score on calibration:    s_i = 1 - p̂(y_i | x_i)
+    4. per class k, with n_k calibration scans of class k:
+           q_k = the ceil((n_k + 1)(1 - alpha))-th smallest score of class k
+    5. prediction set for a new scan:         C(x) = { k : 1 - p̂(k | x) <= q_k }
+"""
+import numpy as np
+from sklearn.base import clone
+from sklearn.model_selection import StratifiedGroupKFold
+
+
+def class_quantiles(scores, y, classes, alpha):
+    q = {}
+    for k in classes:
+        s = np.sort(scores[y == k])
+        n = len(s)
+        r = int(np.ceil((n + 1) * (1 - alpha)))
+        q[k] = np.inf if r > n else s[r - 1]          # too few calibration scans -> include always
+    return q
+
+
+def conformal_cv(model_fn, X, y, groups, alpha=0.05, seed=0, n_splits=5, cal_frac_splits=4):
+    """Outer patient-grouped CV; inside each training fold a patient-grouped calibration split.
+    Returns a boolean matrix S (n_scans x n_classes): S[i, k] = class k is in scan i's set."""
+    classes = np.unique(y)
+    S = np.zeros((len(y), len(classes)), bool)
+    P = np.zeros((len(y), len(classes)))
+    outer = StratifiedGroupKFold(n_splits=n_splits, shuffle=True, random_state=seed)
+    for tr, te in outer.split(X, y, groups):
+        inner = StratifiedGroupKFold(n_splits=cal_frac_splits, shuffle=True, random_state=seed + 1)
+        fit_i, cal_i = next(inner.split(X[tr], y[tr], groups[tr]))
+        fit_i, cal_i = tr[fit_i], tr[cal_i]
+        m = clone(model_fn(seed)).fit(X[fit_i], y[fit_i])
+        order = [list(m.classes_).index(k) for k in classes]
+        pc = m.predict_proba(X[cal_i])[:, order]
+        sc = 1 - pc[np.arange(len(cal_i)), np.searchsorted(classes, y[cal_i])]
+        q = class_quantiles(sc, y[cal_i], classes, alpha)
+        pt = m.predict_proba(X[te])[:, order]
+        P[te] = pt
+        S[te] = (1 - pt) <= np.array([q[k] for k in classes])[None, :]
+    return S, P, classes
+
+
+def summarize(S, y, classes):
+    yi = np.searchsorted(classes, y)
+    hit = S[np.arange(len(y)), yi]
+    size = S.sum(1)
+    single = size == 1
+    pred_single = classes[S.argmax(1)]
+    return {
+        "coverage": float(hit.mean()),
+        "coverage_per_class": {str(k): float(hit[y == k].mean()) for k in classes},
+        "mean_set_size": float(size.mean()),
+        "singleton_rate": float(single.mean()),
+        "singleton_accuracy": float((pred_single[single] == y[single]).mean()) if single.any() else float("nan"),
+        "empty_rate": float((size == 0).mean()),
+    }
diff --git a/retina/ensemble.py b/retina/ensemble.py
new file mode 100644
index 0000000..26f47e5
--- /dev/null
+++ b/retina/ensemble.py
@@ -0,0 +1,43 @@
+"""v5 model zoo: the repo's LR and LightGBM plus an RBF-SVM, combined by soft voting.
+
+Soft voting averages the class probabilities of M different models:
+
+    p̂(k | x) = (1/M) Σ_m p̂_m(k | x),      ŷ = argmax_k p̂(k | x)
+
+The three members make different kinds of mistakes (linear boundary, axis-aligned tree splits,
+smooth kernel boundary), so averaging cancels part of each one's variance. No inner CV is
+needed (unlike stacking), so patient grouping cannot leak.
+"""
+from lightgbm import LGBMClassifier
+from sklearn.ensemble import VotingClassifier
+from sklearn.impute import SimpleImputer
+from sklearn.linear_model import LogisticRegression
+from sklearn.pipeline import make_pipeline
+from sklearn.preprocessing import StandardScaler
+from sklearn.svm import SVC
+
+
+def lr(seed=0, C=0.1):
+    """Same as retina.evaluation.logreg (C=0.1 was confirmed near-optimal by a 0.01-1.0 sweep)."""
+    return make_pipeline(SimpleImputer(strategy="median"), StandardScaler(),
+                         LogisticRegression(C=C, class_weight="balanced", max_iter=5000))
+
+
+def gbm(seed=0, n_jobs=1):
+    """Same hyper-parameters as retina.evaluation.hgb; n_jobs=1 avoids thread over-subscription
+    on 2-4 core laptops (5x faster there, identical predictions)."""
+    return LGBMClassifier(n_estimators=300, learning_rate=0.05, num_leaves=15, min_child_samples=5,
+                          subsample=0.8, subsample_freq=1, colsample_bytree=0.5, reg_lambda=1.0,
+                          class_weight="balanced", random_state=seed, n_jobs=n_jobs, verbose=-1)
+
+
+def svm(seed=0):
+    return make_pipeline(SimpleImputer(strategy="median"), StandardScaler(),
+                         SVC(C=1.0, gamma="scale", class_weight="balanced", probability=True, random_state=seed))
+
+
+def soft_vote(seed=0):
+    return VotingClassifier([("lr", lr(seed)), ("gbm", gbm(seed)), ("svm", svm(seed))], voting="soft")
+
+
+V5_MODELS = {"Logistic regression": lr, "LightGBM": gbm, "Soft vote (LR+GBM+SVM)": soft_vote}
diff --git a/retina/rom.py b/retina/rom.py
new file mode 100644
index 0000000..c58881d
--- /dev/null
+++ b/retina/rom.py
@@ -0,0 +1,100 @@
+"""Reduced-order modelling (ROM) of the feature fields with Proper Orthogonal Decomposition (POD).
+
+The paper's 300 features are not 300 independent numbers: they are two *spatial fields*
+(H on a 10x15 grid, S on a 10x15 grid). The v2 texture features are 11 fields on a 4x5
+(band x sector) grid. Neighbouring cells are strongly correlated, so each field lives close to a
+low-dimensional subspace. POD finds that subspace from data, exactly as in fluid mechanics:
+
+    snapshot matrix   A = [x_1 - x̄, ..., x_n - x̄]^T          (n scans x m cells)
+    thin SVD          A = U Σ V^T
+    POD modes         φ_j = j-th column of V                     (spatial patterns, "eigen-retinas")
+    energy captured   E(r) = Σ_{j<=r} σ_j² / Σ_j σ_j²
+    reduced coords    a = V_r^T (x - x̄)                          (r numbers instead of m)
+    reconstruction    x ≈ x̄ + V_r a
+
+The transformer is fitted inside every CV training fold, so the modes never see test scans.
+"""
+import numpy as np
+from sklearn.base import BaseEstimator, TransformerMixin
+
+
+class FieldPOD(BaseEstimator, TransformerMixin):
+    """Per-field POD + passthrough of scalar features.
+
+    fields      : list of lists of column indices; each inner list is one spatial field
+    passthrough : column indices kept unchanged (scalars such as thickness, fluid fraction)
+    energy      : keep the smallest r with E(r) >= energy (float in (0,1]) or a fixed r (int)
+    scale       : divide each field by its global std (one number per field) so that fields with
+                  different units (H is ~0.1, S is ~10) get comparable weight; the *shape* of every
+                  field is untouched
+    """
+
+    def __init__(self, fields=None, passthrough=None, energy=0.95, scale=True):
+        self.fields = fields
+        self.passthrough = passthrough
+        self.energy = energy
+        self.scale = scale
+
+    def _impute(self, X):
+        X = np.array(X, dtype=float, copy=True)
+        bad = ~np.isfinite(X)
+        if bad.any():
+            X[bad] = np.take(self.median_, np.nonzero(bad)[1])
+        return X
+
+    def fit(self, X, y=None):
+        X = np.asarray(X, dtype=float)
+        with np.errstate(all="ignore"):
+            med = np.nanmedian(np.where(np.isfinite(X), X, np.nan), axis=0)
+        self.median_ = np.nan_to_num(med)
+        X = self._impute(X)
+        self.means_, self.scales_, self.modes_, self.sigma_, self.r_ = [], [], [], [], []
+        for idx in self.fields or []:
+            F = X[:, idx]
+            mu = F.mean(0)
+            A = F - mu
+            sc = A.std() if self.scale and A.std() > 0 else 1.0
+            A = A / sc
+            _, s, Vt = np.linalg.svd(A, full_matrices=False)
+            if isinstance(self.energy, (int, np.integer)):
+                r = int(min(self.energy, len(s)))
+            else:
+                e = np.cumsum(s ** 2) / max((s ** 2).sum(), 1e-12)
+                r = int(np.searchsorted(e, self.energy) + 1)
+            self.means_.append(mu); self.scales_.append(sc)
+            self.modes_.append(Vt[:r]); self.sigma_.append(s); self.r_.append(r)
+        return self
+
+    def transform(self, X):
+        X = self._impute(X)
+        parts = [((X[:, idx] - mu) / sc) @ V.T
+                 for idx, mu, sc, V in zip(self.fields or [], self.means_, self.scales_, self.modes_)]
+        if self.passthrough:
+            parts.append(X[:, self.passthrough])
+        return np.hstack(parts)
+
+    def reconstruct(self, X, field=0):
+        """x̂ = x̄ + V_r V_r^T (x - x̄) for one field (used for the energy / error plots)."""
+        X = self._impute(X)
+        idx, mu, sc, V = self.fields[field], self.means_[field], self.scales_[field], self.modes_[field]
+        a = ((X[:, idx] - mu) / sc) @ V.T
+        return mu + sc * (a @ V)
+
+
+def paper_fields(cols):
+    """Index lists for the paper's H field and S field (150 cells each, grid id = row*15 + col)."""
+    pos = {c: i for i, c in enumerate(cols)}
+    h = [pos[f"grid_{g}_hurst"] for g in range(150) if f"grid_{g}_hurst" in pos]
+    s = [pos[f"grid_{g}_kt1"] for g in range(150) if f"grid_{g}_kt1" in pos]
+    return [f for f in (h, s) if f]
+
+
+def texture_fields(cols, kinds, bands, sectors):
+    """One 20-cell field (4 bands x 5 sectors) per texture kind."""
+    pos = {c: i for i, c in enumerate(cols)}
+    out = []
+    for k in kinds:
+        idx = [pos[f"tex_{b}_{s}_{k}"] for b in bands for s in sectors if f"tex_{b}_{s}_{k}" in pos]
+        if len(idx) >= 3:
+            out.append(idx)
+    return out
